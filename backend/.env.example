# ══════════════════════════════════════════════
# CampusIQ Backend Environment Variables
# Copy to .env and fill in the values.
# Never commit .env to git.
# ══════════════════════════════════════════════

# ── Database (Supabase PostgreSQL) ──
# Get this from: https://supabase.com/dashboard/project/guvzepxyseczqkldlwfq/settings/database
# Use the "Transaction" pooler connection string (port 6543) for serverless-style usage,
# or the "Session" pooler (port 5432) for long-lived connections like local dev.
DATABASE_URL=postgresql+psycopg2://postgres.guvzepxyseczqkldlwfq:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Supabase ──
# Project ID: guvzepxyseczqkldlwfq
SUPABASE_URL=https://guvzepxyseczqkldlwfq.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd1dnplcHh5c2VjenFrbGRsd2ZxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU0NTE0MTgsImV4cCI6MjA5MTAyNzQxOH0.-WjUZQDd_r5lqi-AzaBTD6TvzigA2lmljzewXywrAhU
# Get SERVICE_ROLE_KEY from: https://supabase.com/dashboard/project/guvzepxyseczqkldlwfq/settings/api-keys
# This bypasses RLS — keep it secret
SUPABASE_SERVICE_ROLE_KEY=[GET-FROM-DASHBOARD]
SUPABASE_STORAGE_BUCKET=campusiq-documents

# ── Auth ──
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Redis (used from Phase 12+) ──
REDIS_URL=redis://localhost:6379/0

# ── AI Services ──
# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_DEV=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PROD=claude-opus-4-6
# Set to True ONLY for the final demo. Default False = Haiku for everything.
USE_PRODUCTION_MODEL=False

# OpenAI (Whisper API for voice interview transcription, Phase 20)
OPENAI_API_KEY=sk-...

# ElevenLabs (TTS for voice interview, Phase 20)
ELEVENLABS_API_KEY=...

# ── CORS ──
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ──
ENVIRONMENT=development
